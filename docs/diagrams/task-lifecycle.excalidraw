  {
   "id": "key",
   "type": "text",
   "x": 40,
   "y": 668,
   "width": 500.24,
   "height": 178.75,
   "angle": 0,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1051,
   "version": 1,
   "versionNonce": 5051,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "1  you move a task between backlog and todo\n2  dispatcher launches it (priority order, max_parallel, comment debounce)\n3  Stop hook reports status: done (an agent comment is stored)\n4  Stop with no status block (the agent asked you something), or the\n    reaper finds the background session gone\n5  Stop with unconsumed comments, status: failed below the limit, or a\n    launch error (consecutive_failures goes up)\n6  consecutive failures reach max_consecutive_failures (3)\n7  you answer inside the session (UserPromptSubmit hook)\n8  every PR closed without merge (PR poller adds a system comment)\n9  all PRs merged (PR poller), or you mark it done",
   "originalText": "1  you move a task between backlog and todo\n2  dispatcher launches it (priority order, max_parallel, comment debounce)\n3  Stop hook reports status: done (an agent comment is stored)\n4  Stop with no status block (the agent asked you something), or the\n    reaper finds the background session gone\n5  Stop with unconsumed comments, status: failed below the limit, or a\n    launch error (consecutive_failures goes up)\n6  consecutive failures reach max_consecutive_failures (3)\n7  you answer inside the session (UserPromptSubmit hook)\n8  every PR closed without merge (PR poller adds a system comment)\n9  all PRs merged (PR poller), or you mark it done",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
