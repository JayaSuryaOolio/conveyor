{
  "version": 3,
  "name": "PR check",
  "description": "Check the task's PR for reviews, CI and conflicts",
  "actions": [
    {
      "id": "check",
      "label": "Check PR",
      "places": ["task_sidebar"],
      "output": true,
      "run": "conveyor epic review-check ${{ task.key }}"
    }
  ]
}
